{
	"schemaVersion": 1,
	"id": "useful-hoe",
	"version": "${version}",
	"name": "Useful Hoe",
	"description": "Server-side area farming - tilling, planting, bonemealing, and harvesting. Works with vanilla clients.",
	"authors": [
		"justfatlard"
	],
	"contact": {
		"homepage": "https://github.com/fatlard1993/useful-hoe",
		"sources": "https://github.com/fatlard1993/useful-hoe",
		"issues": "https://github.com/fatlard1993/useful-hoe/issues"
	},
	"license": "MIT",
	"icon": "assets/useful-hoe/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.justfatlard.usefulhoe.UsefulHoe"
		]
	},
	"depends": {
		"fabricloader": ">=${loaderVersion}",
		"fabric-api": "${fabricApiVersion}",
		"minecraft": "${minecraftDependency}",
		"java": ">=25"
	},
	"breaks": {
		"pandorical": "<15.0.0"
	},
	"suggests": {
		"village-quests-justfatlard": "*",
		"emerald-tools-justfatlard": "*",
		"pandorical": "*"
	},
	"mixins": [
		"useful-hoe.mixins.json"
	]
}
